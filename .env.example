# ---------------------------------------------------------------------------
# GapFinder AI environment configuration
#
# Copy to `.env.local` for local development. Never commit real credentials.
# NEXT_PUBLIC_ values are included in the browser bundle and must contain only
# public configuration, never service-role keys or other secrets.
# ---------------------------------------------------------------------------

# Supabase Auth. Leave unset to use the local-only SQLite auth path in
# development and tests. Production requires the URL, one public key, and site URL.
# Set the publishable key, or the legacy anon key for older Supabase projects.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional production demo account. The Supabase user must be marked with
# app_metadata.is_demo=true. Keep the password server-only.
SUPABASE_DEMO_EMAIL=
SUPABASE_DEMO_PASSWORD=

# Optional. When set, the app uses Gemini for embeddings and explanations.
# When unset, the app runs fully offline with deterministic, clearly labelled
# fallbacks (lexical hash embeddings + extractive answers + template questions).
GEMINI_API_KEY=

# Gemini language model used for question generation and explanations.
GEMINI_MODEL=gemini-2.5-flash

# `gemini` (default when a key exists) or `local` to force the offline
# feature-hashing embedder even when GEMINI_API_KEY is set.
EMBEDDING_PROVIDER=

# Gemini embedding model and output dimensionality.
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768

# Dimensions for the deterministic local embedder (gapfinder-hash-v1).
LOCAL_EMBEDDING_DIMENSIONS=512

# Local SQLite database file. Use `:memory:` for tests. The default directory
# is created automatically. This is not durable/shared storage for Vercel.
DATABASE_PATH=data/gapfinder.db

# Upload ceiling in megabytes (1-25).
MAX_UPLOAD_MB=8

# Retrieval: number of passages kept, minimum combined score (0-1), and the
# minimum total characters of evidence required before generation is allowed.
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SCORE=0.15
MIN_EVIDENCE_CHARS=240

# Session lifetime in days (1-30).
SESSION_TTL_DAYS=7

# Set to 1 to disable the shared demo account entirely.
DISABLE_DEMO=0

# Email address reserved for the shared demo account. The demo password is
# generated at runtime and is never printed or published.
DEMO_EMAIL=demo@gapfinder.local
