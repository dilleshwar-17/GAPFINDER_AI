flowchart TB
  subgraph Client["Browser"]
    UI["React Server Components<br/>+ client islands"]
    FETCH["apiRequest helper<br/>(same-origin JSON)"]
  end

  subgraph Next["Next.js 16 App Router"]
    PROXY["src/proxy.ts<br/>Supabase session refresh + route guard<br/>(not the authorization boundary)"]
    PAGES["Pages<br/>(public) · (app) · onboarding"]
    API["Route handlers<br/>src/app/api/**/route.ts"]
    AUTH["Auth helpers<br/>requirePageUser · requireUser"]
    HTTP["http.ts<br/>origin check · Zod · error mapping"]
  end

  subgraph Services["Service layer"]
    SAUTH["auth / session"]
    SDOC["documents"]
    SUB["subjects / topics"]
    SASM["assessment"]
    SGAP["gaps / mastery"]
    SPLAN["plans"]
    SAST["assistant"]
    SPROG["progress / preferences"]
    SDEMO["demo seeding + guards"]
  end

  subgraph Domain["Pure domain rules"]
    CHUNK["chunking"]
    SCORE["scoring"]
    MAST["mastery bands + evidence"]
    PLAN["planner weights + caps"]
    CITE["citation validation"]
  end

  subgraph AI["AI adapters"]
    EMB["embeddings<br/>Gemini or local hash"]
    GEN["question generation<br/>Gemini or deterministic"]
    EVAL["short-answer evaluation"]
    RET["retrieval<br/>authorized vector scan"]
  end

  subgraph Data["Persistence"]
    SELECTDB["DATABASE_URL selects backend"]
    SQLITE[("Local SQLite<br/>node:sqlite")]
    POSTGRES[("Hosted PostgreSQL<br/>pg adapter")]
    FILES[("Database binary columns<br/>BLOB / BYTEA uploads + embeddings")]
    SELECTDB --> SQLITE
    SELECTDB --> POSTGRES
    SQLITE --> FILES
    POSTGRES --> FILES
  end

  subgraph Identity["Authentication"]
    SUPA["Supabase Auth<br/>(when configured)"]
    LOCALAUTH["Local scrypt + hashed sessions<br/>(non-production fallback)"]
  end

  subgraph Ext["Optional external"]
    GEM["Gemini API<br/>(only when key configured)"]
  end

  UI --> PROXY --> PAGES
  UI --> FETCH --> API
  PAGES --> AUTH
  API --> HTTP --> AUTH
  AUTH --> SUPA
  AUTH --> LOCALAUTH
  PAGES --> Services
  API --> Services
  Services --> Domain
  SASM --> RET
  SAST --> RET
  RET --> EMB
  GEN --> EMB
  SGAP --> MAST
  SPLAN --> PLAN
  SASM --> SCORE
  Services --> SELECTDB
  SDOC --> FILES
  EMB -.-> GEM
  GEN -.-> GEM
  EVAL -.-> GEM
